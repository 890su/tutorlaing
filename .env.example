# Telegram token from BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=

# Optional comma-separated Telegram chat IDs for a closed alpha.
TELEGRAM_ALLOWED_CHAT_IDS=

DATA_DIR=/data
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
POLL_TIMEOUT=25
LOG_LEVEL=INFO

# Production webhook mode. Set both values or leave both empty for polling.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET_FILE=

# AI analysis. Keep real keys only in a protected local/server .env.
AI_PROVIDER=none
AI_FALLBACK_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
AI_TIMEOUT=45
AI_FAILOVER_COOLDOWN=300

# Background reminder scheduler. User reminders are opt-in and default to off.
REMINDER_SCAN_SECONDS=60
